{
  "name": "richie696-react-library",
  "version": "1.0.1",
  "private": true,
  "description": "Framework-neutral and React-native foundations for Richie696 applications.",
  "license": "MIT",
  "author": "richie696",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richie696/richie696-react-library.git"
  },
  "bugs": { "url": "https://github.com/richie696/richie696-react-library/issues" },
  "homepage": "https://github.com/richie696/richie696-react-library#readme",
  "keywords": ["react", "react19", "typescript", "framework", "hooks", "web-crypto", "concurrency"],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "typecheck": "pnpm run build && pnpm -r --workspace-concurrency=1 run typecheck",
    "clean": "pnpm -r --workspace-concurrency=1 run clean"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
